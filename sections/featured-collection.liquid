{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

    @media screen and (max-width: 749px) {
    #collection-{{ section.id }} .grid__item {
      width: calc(50% - var(--grid-desktop-horizontal-spacing) * 2 / 3);
      margin-left: 0rem;
    }

    #collection-{{ section.id }} .slider.slider--tablet {
      scroll-padding-left: 0rem;
    }
  }

  /* The four --grid-*-spacing overrides that used to live here are gone: the
     gutter is now zeroed globally via spacing_grid_horizontal /
     spacing_grid_vertical in settings_data.json, so every product grid in the
     theme is full-bleed, not just this section. The calc() below still reads
     --grid-desktop-horizontal-spacing, which now resolves to 0px from
     theme.liquid rather than from here. */

    @media screen and (min-width: 750px) and (max-width: 989px) {
        #collection-{{ section.id }} .grid__item {
        width: calc(33.33% - var(--grid-mobile-horizontal-spacing) * 2 / 2);
        margin-left: 0rem;
        }

        #collection-{{ section.id }} .slider.slider--tablet {
          scroll-padding-left: 0rem; 
        }
    }

    #collection-{{ section.id }} {
      position: relative; 
      --vv-rule-color: var(--vv-hairline);
    }

    {% comment %}
    The heading is an overlay on the row, not a band above it. Whether it shows
    at all is a per-section setting, not a CSS decision: this style block is
    emitted once per section instance, so hiding the title here would hide it on
    every featured-collection in the theme. Blank `title` in the editor instead.
    {% endcomment %}

    #collection-{{ section.id }} .collection__title {
      position: absolute;
      top: 0; 
      left: 0; 
      padding: var(--vv-text-inset) 0 0 var(--vv-text-inset);
      z-index: 1;
    }

    @media screen and (min-width: 990px) {
      #collection-{{ section.id }} .slider {
        scroll-snap-type: x proximity; 
      }
    }

    #collection-{{ section.id }} .slider__slide {
      --focus-outline-padding: 0rem; 
    }

    #collection-{{ section.id }} .slider-counter {
      display: none; 
    }

    #collection-{{ section.id }} .product-grid {
      margin-block-start: 0rem;
      margin-block-end: 0rem;
      background-color: var(--vv-hairline); 
    }

    #collection-{{ section.id }} slider-component {
      --desktop-margin-left-first-item: 0px;
    }

      /* Lifts slider arrow buttons out of the flow, stretches them across and centers them vertically.
      Pointer events makes sure that the product card buttons remain clickable beneath the stretched row.*/

    #collection-{{ section.id }} .slider-buttons {
      position: absolute; 
      top: 0; 
      bottom: 0; 
      left: 0; 
      right: 0; 
      justify-content: space-between;
      pointer-events: none; 
      --color-foreground: 0, 0, 0; 
    }

    #collection-{{ section.id }} .slider-button {
      pointer-events: auto; 
    } 

    #collection-{{ section.id }} .slider-buttons .icon {
      height: 1.5rem;
    }

    #collection-{{ section.id }} .collection__view-all {
      position: absolute; 
      bottom: 0; 
      right: 0; 
      padding: 0 var(--vv-text-inset) var(--vv-text-inset) 0;
    }

    /* Dawn tacks a 5rem pseudo-element onto the end of the desktop track so the
       last card is not flush to the edge, and claws back one gutter's width via
       margin-left. Our gutter is 0px, so the full 5rem survived and every column
       sat 50px left of the hairlines at maximum scroll. This is the trailing twin
       of the --desktop-margin-left-first-item override above. */
    #collection-{{ section.id }} .slider--desktop::after {
      padding-left: 0;
    }
    
    #collection-{{ section.id }} .slider--tablet:after {
      padding-left: 0;
    }


    {% comment %}
    Painting nothing so the page-wide hairline overlay shows through. 
    {% endcomment %}

    div.vv-no-bg { background-color: transparent; }

    #collection-{{ section.id }} .grid__item {
      box-shadow: 0 -1px 0 var(--vv-rule-color);
    }

    #collection-{{ section.id }} .card__information {
      padding-left: var(--vv-text-inset);
      padding-right: var(--vv-text-inset);
      --color-foreground: 0, 0, 0;
    }

    {% comment %}
    Product text rides the lower portion of the image instead of sitting below
    it. Absolute positioning takes it out of flow, so the image becomes the only
    thing setting the card's height, and .card-wrapper's existing position:
    relative is the containing block.

    The backing is the other half: legibility has to come from the card, not
    from the photograph happening to be pale.
    {% endcomment %}

    #collection-{{ section.id }} .card > .card__content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding-left: 0;
      padding-right: 0;
      --vv-glass-tint: 1;
      isolation: isolate;
    }
    {% comment %}
    The frost sits on a pseudo-element, not on .card__content itself: a mask
    fades an element's children along with it, and the children here are the
    title and price. Isolating the frost lets the mask fade the blur while the
    text stays sharp.

    z-index: -1 puts it behind the title, price and badge without those needing
    to be positioned themselves. 7d rejected this because .card__content had
    z-index: auto and so created no stacking context, which let -1 escape the
    subtree and slide behind the product image. `isolation: isolate` above
    creates that context without touching position or z-index, so -1 is now
    clamped to the bottom of .card__content's own layer -- still above the
    image, because .card__content as a whole paints above .card__inner.
    {% endcomment %}

    #collection-{{ section.id }} .card > .card__content::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      backdrop-filter: blur(var(--vv-glass-blur)) saturate(1.15) brightness(1.05);
      -webkit-backdrop-filter: blur(var(--vv-glass-blur)) saturate(1.15) brightness(1.05);
      background-image: linear-gradient(to right, rgba(255, 255, 255, var(--vv-glass-tint)), rgba(255, 255, 255, 0));
      mask-image: linear-gradient(to right, #ffffff 60%, transparent);
      -webkit-mask-image: linear-gradient(to right, #ffffff 60%, transparent);
    }

    {% comment %}
    Give the card its link back.

    Dawn makes a whole card clickable with .card__heading a::after -- an empty
    absolutely positioned box with inset: 0, which fills its nearest positioned
    ancestor. That is meant to be .card-wrapper. 7d put .card__content (absolute)
    in between, so the link shrank to the strip of text over the image and the
    photograph stopped responding to clicks.

    padding-top rather than height or a negative top: a percentage in top or
    height resolves against the containing block's HEIGHT, which here is only
    the text band. A percentage in padding always resolves against its WIDTH --
    vertical padding included. .card__content is pinned left: 0 / right: 0, so
    its width is the card's width, and the card's height is exactly
    --ratio-percent of that width. That is the same variable Dawn sets inline on
    .card and .card__inner from the image_ratio setting
    (snippets/card-product.liquid:56), so the overlay comes out exactly one card
    tall with no magic number, and re-derives itself if the ratio ever changes.
    {% endcomment %}

    #collection-{{ section.id }} .card__heading a::after {
      top: auto;
      padding-top: var(--ratio-percent);
    }

{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count

  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign max_columns_to_show = columns_mobile_int
  if columns_desktop_int > columns_mobile_int
    assign max_columns_to_show = columns_desktop_int
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif

  # The wrapper is positioned and carries padding, so an empty one is still a
  # hit target over the corner of the first card. Render it only when it has
  # something in it. Mirrors the two conditions inside it.
  assign show_collection_heading = false
  if section.settings.title != blank
    assign show_collection_heading = true
  endif
  if section.settings.description != blank
    assign show_collection_heading = true
  endif
  if section.settings.show_description and section.settings.collection.description != empty
    assign show_collection_heading = true
  endif
-%}

<div
  class="color-{{ section.settings.color_scheme }} isolate vv-no-bg"
>
  <div
    class="collection{% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %} section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    {%- comment -%}
      No `page-width` here: it contained the heading to 1200 while the grid
      below is full-bleed, so the heading read as a separate row rather than
      part of the grid. Without it the heading starts on the grid's outer edge,
      flush with the first column's content.
    {%- endcomment -%}
    {%- if show_collection_heading -%}
    <div class="collection__title title-wrapper title-wrapper--no-top-margin{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% endif %}{% if show_desktop_slider %} collection__title--desktop-slider{% endif %}">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank
        or section.settings.show_description
        and section.settings.collection.description != empty
      -%}
        <div class="collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.show_description -%}
            {{ section.settings.collection.description }}
          {%- else -%}
            {{ section.settings.description -}}
          {%- endif %}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_tablet }}-col-tablet{% if section.settings.collection == blank %} grid--2-col{% else %} grid--{{ section.settings.columns_mobile }}-col{% endif %}{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {% assign skip_card_product_styles = false %}

        {%- if section.settings.collection.products.size > 0 -%}
          {% assign lazy_load = false %}
          {% paginate section.settings.collection.products by section.settings.products_to_show %}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              {% if lazy_load == false and forloop.index > max_columns_to_show %}
                {% assign lazy_load = true %}
              {% endif %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  lazy_load: lazy_load,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  product_view_context: 'collection'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {% endpaginate %}
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% liquid
                assign ridx = forloop.rindex
                case ridx
                  when 5
                    assign ridx = 1
                  when 6
                    assign ridx = 2
                endcase
              %}
              {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
              {% render 'card-product',
                show_vendor: section.settings.show_vendor,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                lazy_load: false,
                placeholder_image: placeholder_image
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ products_to_display }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and more_in_collection -%}
      <div class="center collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <a
          href="{{ section.settings.collection.url }}"
          class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title | escape }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    const track = document.getElementById('Slider-{{ section.id }}');
    if (!track) return;

    // Hijacking the wheel is a motion effect. If the visitor has asked for less
    // of it, leave scrolling alone entirely -- the arrows still work.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Fraction of the remaining distance travelled each frame. Lower is slower
    // and smoother; 1 would be an instant jump.
    const EASING = 0.14;
    // A line-mode delta (Firefox) is about 3 per notch against Chrome's 100.
    const LINE_HEIGHT = 33;
    // Quiet time after the last wheel tick before the row settles onto a column.
    const SETTLE_DELAY = 120;

    let target = track.scrollLeft;
    let rafId = null;
    let settleTimer = null;

    function maxScroll() {
      return track.scrollWidth - track.clientWidth;
    }

    // Distance from one column to the next, measured off the live layout rather
    // than recomputed from the column count, so it stays right at every
    // breakpoint. getBoundingClientRect is used instead of offsetLeft because
    // offsetLeft rounds to whole pixels and the column pitch is fractional
    // (a quarter of the track, e.g. 423.75) -- the rounding error would
    // accumulate across the row.
    function columnPitch() {
      if (track.children.length < 2) return 0;
      const a = track.children[0].getBoundingClientRect().left;
      const b = track.children[1].getBoundingClientRect().left;
      return b - a;
    }

    // The listener is on window, so the row would otherwise swallow page
    // scrolling from anywhere in the document -- including before it has been
    // reached. It only takes the wheel while it actually overlaps the middle of
    // the viewport.
    function inView() {
      const rect = track.getBoundingClientRect();
      const h = window.innerHeight;
      return rect.bottom > h * 0.25 && rect.top < h * 0.75;
    }

    function restoreSnap() {
      track.style.scrollSnapType = '';
    }

    function step() {
      const current = track.scrollLeft;
      const diff = target - current;

      if (Math.abs(diff) < 0.5) {
        track.scrollTo({ left: target, behavior: 'instant' });
        rafId = null;
        // Only hand snapping back once no settle is still pending, or the
        // stylesheet's rule would fight the settle animation.
        if (settleTimer === null) restoreSnap();
        return;
      }

      let scrollAmount = diff * EASING;
      const magnitude = Math.abs(scrollAmount);
      const direction = Math.sign(scrollAmount); 
      scrollAmount = direction * Math.max(1, Math.round(magnitude));

      // behavior 'instant' per frame, so the CSS `scroll-behavior: smooth` that
      // the arrow buttons rely on cannot animate against this loop.
      track.scrollTo({ left: current + scrollAmount, behavior: 'instant' });
      rafId = window.requestAnimationFrame(step);
    }

    // Alignment is done here rather than left to `scroll-snap-type: proximity`,
    // which only settles when it happens to land inside its own threshold and so
    // leaves the columns a few pixels off the hairlines. Rounding the target to a
    // whole number of columns puts them on the lines every time, and the easing
    // loop glides there.
    function settle() {
      settleTimer = null;
      const pitch = columnPitch();
      if (pitch > 0) {
        const limit = maxScroll();
        target = Math.min(limit, Math.max(0, Math.round(target / pitch) * pitch));
        target = Math.round(target); // avoid fractional pixels
      }
      if (rafId !== null) return;
      if (Math.abs(track.scrollLeft - target) < 0.5) {
        restoreSnap();
      } else {
        rafId = window.requestAnimationFrame(step);
      }
    }

    window.addEventListener(
      'wheel',
      function (event) {
        if (!inView()) return;

        const delta = event.deltaMode === 1 ? event.deltaY * LINE_HEIGHT : event.deltaY;
        const max = maxScroll();

        // Fewer products than columns, or a viewport the track already fits:
        // there is nothing to consume.
        if (max <= 0) return;

        // Resync before testing, in case the arrows or a drag moved the row
        // since the last gesture.
        if (rafId === null && settleTimer === null) target = track.scrollLeft;

        // No room left in the direction of travel: consume nothing and let the
        // page scroll as it normally would.
        if (delta > 0 && target >= max - 1) return;
        if (delta < 0 && target <= 1) return;

        event.preventDefault();

        // Measured against the target rather than the live position, so ticks
        // arriving mid-animation queue up instead of being dropped.
        target = Math.min(max, Math.max(0, target + delta));

        track.style.scrollSnapType = 'none';
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(settle, SETTLE_DELAY);

        if (rafId === null) rafId = window.requestAnimationFrame(step);
      },
      { passive: false }
    );
  })();
</script>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-collection.settings.show_description.label",
      "default": false
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_collection.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"

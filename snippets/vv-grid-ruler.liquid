{% comment %}
Dev-only column ruler for debugging. Append ?grid to any URL to show it.
Delete its render in layout/theme.liquid when the grid work lands.
{% endcomment %}

<div class="vv-grid-ruler" aria-hidden="true" hidden>
  <span></span><span></span><span></span><span></span>
</div>

<style>
  .vv-grid-ruler {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    box-shadow: inset -1px 0 0 rgba(255, 0, 128, 0.9);
  }

  .vv-grid-ruler[hidden] {
    display: none;
  }

  .vv-grid-ruler span {
    border-left: 1px solid rgba(255, 0, 128, 0.9);
    background: rgba(255, 0, 128, 0.05);
  }

  .vv-grid-ruler span:nth-child(n+3) {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .vv-grid-ruler {
      grid-template-columns: repeat(3, 1fr);
    }
    .vv-grid-ruler span:nth-child(3) {
      display: block;
    }
  }

  @media screen and (min-width: 990px) {
    .vv-grid-ruler {
      grid-template-columns: repeat(4, 1fr);
    }
    .vv-grid-ruler span:nth-child(4) {
      display: block;
    }
  }
</style>

<script>
  if (new URLSearchParams(window.location.search).has('grid')) {
    const el = document.querySelector('.vv-grid-ruler');
    if (el) el.hidden = false;
  }
</script>